# ==========================================
# Subscription Rotation Mailer Configuration
# ==========================================

PORT=5000
NODE_ENV=production

# ------------------------------------------
# 1. EMAIL CONFIGURATION (RECOMMENDED: GMAIL APP PASSWORD)
# ------------------------------------------
# To get a 16-character Google App Password:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create app name "SubRotation" and copy the 16-character password (e.g. "abcd efgh ijkl mnop")
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your16charpassword

# Sender name shown in email client
EMAIL_FROM_NAME="Subscription Rotation Reminder"
EMAIL_FROM_ADDRESS=your-email@gmail.com

# (Optional) If using Brevo, Amazon SES, or custom SMTP instead of Gmail:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-brevo-login
# SMTP_PASS=your-brevo-smtp-key

# ------------------------------------------
# 2. DATABASE CONFIGURATION (OPTIONAL FOR RENDER)
# ------------------------------------------
# By default, runs using a local JSON file in data/database.json.
# For persistent storage on Render (recommended for production):
# Paste a free PostgreSQL URL from Neon (https://neon.tech), Supabase (https://supabase.com), or Render Postgres:
# DATABASE_URL=postgresql://user:password@ep-host.region.neon.tech/dbname?sslmode=require

# ------------------------------------------
# 3. CRON & WEBHOOK SECRET
# ------------------------------------------
# Internal scheduler schedule (cron expression)
CRON_SCHEDULE="0 9 * * *"

# Secret token used by external free cron ping (cron-job.org / GitHub Actions)
# Endpoint: POST /api/cron/trigger?secret=your-secret-token
CRON_SECRET=subscription-secret-token-123

